# ===================================================================
# Vehicle Diary — application environment (Fleet standalone)
# -------------------------------------------------------------------
# Copy to /etc/vehicle-diary/fleet.env, then replace EVERY CHANGE_ME.
# ProductionConfigValidator hard-stops the boot on a placeholder secret, so a
# half-filled file fails loudly at startup rather than quietly running insecure.
#
# Deliberately SHORTER than deploy/travelcrm.env.example: a Fleet-only deployment
# has no quotations, no traveler portal, no lead webhooks and no subscription
# billing, so the keys that serve those are simply absent rather than blank.
# ===================================================================

SPRING_PROFILES_ACTIVE=prod

# ── The flag that makes this the Fleet product ─────────────────────────────────
# CRM_SUITE (default) | FLEET_STANDALONE. Selects the standalone fleet adapters,
# so no code path reads a booking or vendor table. Note this is PACKAGING, not
# authorisation: what actually closes the CRM endpoints is provisioning the tenant
# on the FLEET plan, whose module set is {FLEET}. See docs/FLEET_STANDALONE_DEPLOY.md.
APP_PRODUCT_MODE=FLEET_STANDALONE

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/vehicle_diary
DB_USERNAME=fleet
DB_PASSWORD=CHANGE_ME

# ── Secrets ────────────────────────────────────────────────────────────────────
# Base64 HMAC keys, 32+ bytes each. Generate with:  openssl rand -base64 48
# PORTAL_JWT_SECRET must DIFFER from JWT_SECRET even here: the traveler portal
# chain validates against it, and sharing one key is what lets a token cross realms.
JWT_SECRET=CHANGE_ME
PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT
# At-rest encryption for stored tenant credentials (mail passwords, API keys).
APP_ENCRYPTION_KEY=CHANGE_ME

# ── Platform administrator ─────────────────────────────────────────────────────
# Creates the SuperAdmin who provisions the operator's tenant. One is enough for a
# single-customer install.
SUPERADMIN_1_EMAIL=CHANGE_ME
SUPERADMIN_1_PASSWORD=CHANGE_ME
JWT_SUPER_ADMIN_EXPIRY_MS=1800000
APP_SUPER_ADMIN_LOCKOUT_MAX_FAILED_ATTEMPTS=5
APP_SUPER_ADMIN_LOCKOUT_DURATION_SECONDS=900
APP_MFA_ISSUER=Vehicle Diary

# ── URLs ───────────────────────────────────────────────────────────────────────
# Single-origin: the SPA and /api share one hostname, which is why there is no
# CORS list here. Set both to the same public URL.
APP_PUBLIC_BASE_URL=https://fleet.example.com
APP_CONSOLE_BASE_URL=https://fleet.example.com

# ── Mail (document-expiry alerts, settlement notifications) ─────────────────────
# Optional. Left blank the app still runs; alerts then exist only in-app.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Image hosting (vehicle photos only) ────────────────────────────────────────
# Optional. NOTE: receipts, certificate scans and signed settlement sheets do NOT
# go here — they are stored as Postgres bytea and served only through the
# authenticated download endpoint, because Cloudinary URLs are public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Schema ─────────────────────────────────────────────────────────────────────
# Leave false and apply migrations by hand on first install (runbook step 3),
# then set true once V1+V2 are stamped in flyway_schema_history.
FLYWAY_ENABLED=false

# ── Off by default in this product ─────────────────────────────────────────────
RAZORPAY_ENABLED=false
DISHA_ENABLED=false
