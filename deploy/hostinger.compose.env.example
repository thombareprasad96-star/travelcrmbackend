# ===================================================================
# TravelCRM - Hostinger Docker Compose environment
# -------------------------------------------------------------------
# Copy to /opt/travelcrm-be/.env on the VPS and chmod 600.
# This file is read by Docker Compose. App secrets stay in
# /etc/travelcrm/travelcrm.env.
# ===================================================================

# CI overrides this with the exact git SHA tag during deployment.
TRAVELCRM_IMAGE=your-dockerhub-username/travelcrm-backend:latest

# App secrets/env live here. Keep the default on the VPS.
APP_ENV_FILE=/etc/travelcrm/travelcrm.env

# Postgres runs inside the Compose project on the private backend network.
POSTGRES_DB=travel_crm
POSTGRES_USER=travelcrm
# openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# nginx should proxy to http://127.0.0.1:8080.
HOST_BIND_PORT=8080

# Optional deploy cleanup.
PRUNE_OLD_IMAGES=true
TZ=Asia/Kolkata
