# ===================================================================
# TravelCRM - production environment
# -------------------------------------------------------------------
# Copy to /etc/travelcrm/travelcrm.env on the VPS, fill in EVERY value, then:
#     sudo chown root:travelcrm /etc/travelcrm/travelcrm.env
#     sudo chmod 640            /etc/travelcrm/travelcrm.env
# 640 matters: this file is the whole keyring. Anything world-readable here is
# equivalent to publishing it.
#
# systemd reads this via EnvironmentFile=, and Docker Compose can read it via
# env_file. Format is KEY=value, one per line - NOT a shell script: no `export`,
# no ${OTHER_VAR} interpolation, and quotes are taken literally. Do not add
# inline comments after a value.
#
# Every secret here is declared in application-prod.properties as ${VAR} with no
# default, so a missing one fails the boot loudly. ProductionConfigValidator
# additionally refuses to start if any value is still a dev default.
# ===================================================================

SPRING_PROFILES_ACTIVE=prod

# --- Database -------------------------------------------------------
# In the Docker Compose Hostinger deployment, docker-compose.hostinger.yml
# overrides DB_URL/DB_USERNAME/DB_PASSWORD from /opt/travelcrm/.env so the app
# talks to the private `postgres` service. For the older systemd/JAR deployment,
# the app connects over localhost; Postgres is not exposed to the internet.
DB_URL=jdbc:postgresql://localhost:5432/travel_crm
DB_USERNAME=travelcrm
# openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# --- Auth / crypto --------------------------------------------------
# Generate EACH of these separately: openssl rand -base64 32
# JWT_SECRET and PORTAL_JWT_SECRET must be DIFFERENT values; they are the only
# thing separating the staff realm from the traveler-portal realm.
JWT_SECRET=CHANGE_ME
PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT
# SuperAdmin console token TTL. Default: 30 minutes.
JWT_SUPER_ADMIN_EXPIRY_MS=1800000

APP_SUPER_ADMIN_LOCKOUT_MAX_FAILED_ATTEMPTS=5
APP_SUPER_ADMIN_LOCKOUT_DURATION_SECONDS=900
APP_SUPER_ADMIN_PASSWORD_MIN_LENGTH=12
APP_SUPER_ADMIN_PASSWORD_MAX_LENGTH=128
APP_SUPER_ADMIN_INVITE_TTL_HOURS=24
APP_SUPER_ADMIN_LOGIN_ALERTS_ENABLED=true
APP_SUPER_ADMIN_LOGIN_ALERTS_FROM_EMAIL=vetotechit@gmail.com
APP_SUPER_ADMIN_LOGIN_ALERTS_FROM_NAME=Veto Tech IT

# --- Platform SuperAdmins ------------------------------------------
# Startup bootstrap is restricted to exactly the two fixed emails below.
# Passwords are mandatory only when a row does not already exist; the runner
# never overwrites an existing row.
# To change the password after first boot, use POST /api/super-admin/me/change-password.
# Editing this file later has no effect once the row exists.
SUPERADMIN_1_EMAIL=rajpoottours2789@gmail.com
# openssl rand -base64 24
SUPERADMIN_1_PASSWORD=CHANGE_ME
SUPERADMIN_2_EMAIL=thombareprasad96@gmail.com
# openssl rand -base64 24
SUPERADMIN_2_PASSWORD=CHANGE_ME

# Frontend console origin, used when generating SuperAdmin invite links.
APP_CONSOLE_BASE_URL=https://crm.mytripsafar.com

# SuperAdmin MFA is mandatory. The issuer is the name shown inside authenticator apps.
APP_MFA_ISSUER=TravelCRM
# Optional tuning; defaults are 300 seconds and 5 attempts.
# APP_MFA_CHALLENGE_TTL_SECONDS=300
# APP_MFA_MAX_ATTEMPTS=5

# AES-256 key (Base64, 32 bytes) encrypting each tenant's stored SMTP password
# and WhatsApp API key. Set once and never change; rotating it makes every
# existing ciphertext in tenant_settings undecryptable.
APP_ENCRYPTION_KEY=CHANGE_ME

# --- Public URLs ----------------------------------------------------
# The public https:// origin of THIS API. Quotation share links and the Razorpay
# webhook URL are built from it.
APP_PUBLIC_BASE_URL=https://api.mytripsafar.com
# Exact frontend origin(s), comma-separated. Never "*" (allowCredentials=true is on).
APP_CORS_ALLOWED_ORIGINS=https://mytripsafar.com,https://www.mytripsafar.com

# --- Email (platform CRM sender) ------------------------------------
# Used only for SuperAdmin/platform security mail. Tenant/customer email uses
# each tenant's Settings > Email SMTP config and must not fall back here.
# Gmail requires an App Password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=vetotechit@gmail.com
MAIL_PASSWORD=

# --- Cloudinary (image uploads) -------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (SaaS subscription billing) ---------------------------
# Leave RAZORPAY_ENABLED=false to ship without billing: the app boots, the
# endpoints exist, and order creation returns 503 until real keys are set.
# The webhook secret must match the value set in the Razorpay dashboard, with
# URL ${APP_PUBLIC_BASE_URL}/api/webhooks/razorpay.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Disha AI assistant ---------------------------------------------
# Not deployed this sprint. application-prod.properties pins disha.enabled=false,
# which removes /ai/chat entirely and makes GET /api/me/features report {"disha":false}.
# GROQ_API_KEY=

# --- Tuning (optional; sane defaults live in application-prod.properties) ---
# TOMCAT_MAX_THREADS=100
# DB_POOL_MAX_SIZE=10
# TRASH_RETENTION_DAYS=30
# LOG_DIR=/var/log/travelcrm
# Flyway cutover: enable only after V1__baseline_schema.sql is reviewed and
# present under src/main/resources/db/migration in the deployed jar.
# FLYWAY_ENABLED=true
# FLYWAY_BASELINE_ON_MIGRATE=false
# FLYWAY_BASELINE_VERSION=1
# Existing-schema adoption only: set true for the one baseline-stamp run, then
# immediately remove it. ProductionConfigValidator blocks leaving it on.
# APP_FLYWAY_ALLOW_BASELINE_ON_MIGRATE=true
# Pilot/pre-cutover only:
# JPA_DDL_AUTO=update
# Switch to `validate` once Flyway owns schema changes (see docs/DEPLOYMENT.md).
# JPA_DDL_AUTO=validate
# Disable Spring SQL init once the accepted Flyway baseline includes db/indexes.sql's final DDL.
# SQL_INIT_MODE=never
