# ===================================================================
# TravelCRM — production environment
# -------------------------------------------------------------------
# Copy to /etc/travelcrm/travelcrm.env on the VPS, fill in EVERY value, then:
#     sudo chown root:travelcrm /etc/travelcrm/travelcrm.env
#     sudo chmod 640            /etc/travelcrm/travelcrm.env
# 640 matters: this file is the whole keyring. Anything world-readable here is
# equivalent to publishing it.
#
# systemd reads this via EnvironmentFile= (see travelcrm.service). Format is
# KEY=value, one per line — NOT a shell script: no `export`, no ${OTHER_VAR}
# interpolation, and quotes are taken literally. Do not add inline comments
# after a value.
#
# Every secret here is declared in application-prod.properties as ${VAR} with no
# default, so a missing one fails the boot loudly. ProductionConfigValidator
# additionally refuses to start if any value is still a dev default.
# ===================================================================

SPRING_PROFILES_ACTIVE=prod

# --- Database -------------------------------------------------------
# The app connects over localhost; Postgres is not exposed to the internet.
DB_URL=jdbc:postgresql://localhost:5432/travel_crm
DB_USERNAME=travelcrm
# openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# --- Auth / crypto --------------------------------------------------
# Generate EACH of these separately:  openssl rand -base64 32
# JWT_SECRET and PORTAL_JWT_SECRET must be DIFFERENT values — they are the only
# thing separating the staff realm from the traveler-portal realm. The validator
# rejects identical keys at boot.
JWT_SECRET=CHANGE_ME
PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT

# Header required to register the SuperAdmin. Long and random; you need it once.
SUPERADMIN_SIGNUP_SECRET=CHANGE_ME

# --- Platform SuperAdmin (created on the FIRST boot only) -----------
# DataInitializer creates this account when super_admins is empty. Under the prod
# profile SUPER_ADMIN_PASSWORD is MANDATORY — a missing one fails the boot rather than
# falling back to the development password, which is public in this repository's git
# history and would be live on the internet-facing login form.
# The account is NOT recoverable by signup afterwards: AuthServiceImpl refuses to
# register a second SuperAdmin once this row exists.
# SUPER_ADMIN_EMAIL is optional (defaults to superadmin@travelcrm.com).
# To change the password AFTER the first boot, use POST /api/super-admin/me/change-password
# — editing this file later has no effect, the runner is a no-op once the row exists.
SUPER_ADMIN_EMAIL=
# openssl rand -base64 24
SUPER_ADMIN_PASSWORD=CHANGE_ME

# AES-256 key (Base64, 32 bytes) encrypting each tenant's stored SMTP password and
# WhatsApp API key.  ⚠ SET ONCE AND NEVER CHANGE — rotating it makes every existing
# ciphertext in tenant_settings undecryptable with no way back. Back it up separately
# from the database: losing it and losing the DB are different disasters, and storing
# them together turns two disasters into one.
APP_ENCRYPTION_KEY=CHANGE_ME

# --- Public URLs ----------------------------------------------------
# The public https:// origin of THIS API. Quotation share links and the Razorpay
# webhook URL are built from it.
APP_PUBLIC_BASE_URL=https://api.mytripsafar.com
# Exact frontend origin(s), comma-separated. Never "*" (allowCredentials=true is on).
# BOTH hostnames are required: nginx serves the SPA on the apex AND on www, so a
# user who lands on www.mytripsafar.com sends Origin: https://www.mytripsafar.com.
# List only the apex and every API call from www fails CORS — while the apex works
# fine, which makes it look like an intermittent bug rather than a config gap.
APP_CORS_ALLOWED_ORIGINS=https://mytripsafar.com,https://www.mytripsafar.com

# --- Email (app-wide fallback sender) -------------------------------
# Per-tenant SMTP is configured in-app and takes precedence over this.
# Gmail requires an App Password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Cloudinary (image uploads) -------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (SaaS subscription billing) ---------------------------
# Leave RAZORPAY_ENABLED=false to ship without billing: the app boots, the endpoints
# exist, and order creation returns 503 until real keys are set.
# The webhook secret must MATCH the value set in the Razorpay dashboard → Webhooks,
# with the URL ${APP_PUBLIC_BASE_URL}/api/webhooks/razorpay
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Disha AI assistant ---------------------------------------------
# NOT DEPLOYED THIS SPRINT. application-prod.properties pins disha.enabled=false,
# which removes /ai/chat entirely and makes GET /api/me/features report {"disha":false}
# so the frontend hides the widget. Leave GROQ_API_KEY unset — it is not read while
# the feature is off. To re-enable: see the DISHA block in application-prod.properties.
# GROQ_API_KEY=

# --- Tuning (optional — sane defaults live in application-prod.properties) ---
# TOMCAT_MAX_THREADS=100
# DB_POOL_MAX_SIZE=10
# TRASH_RETENTION_DAYS=30
# LOG_DIR=/var/log/travelcrm
# Switch to `validate` once Flyway migrations exist (see docs/DEPLOYMENT.md).
# JPA_DDL_AUTO=update